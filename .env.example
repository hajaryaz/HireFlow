# Copier ce fichier en .env puis remplir les valeurs : cp .env.example .env

# --- Airflow ---
# Générer la clé Fernet :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
# Chaîne aléatoire quelconque (ex. : python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=

# --- API France Travail (OAuth2) ---
# Identifiants à créer sur https://francetravail.io (API "Offres d'emploi v2")
FT_CLIENT_ID=
FT_CLIENT_SECRET=
